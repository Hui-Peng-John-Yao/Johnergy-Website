<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Calendar</title>
  <%# Bootstrap and Calender css%>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/index.global.min.css" rel="stylesheet" />
  <%# Customization %>
  <style>
    body {
      font-family: 'Helvetica', sans-serif;
      background-color: #f8f9fa;
    }

    #calendar {
      max-width: 900px;
      margin: 0 auto;
    }

    .fc-toolbar-title {
      font-weight: 600;
      font-size: 1.75rem;
    }

    .fc .fc-button {
      background-color: #140455;
      border: none;
    }

    .fc .fc-button:hover {
      background-color: #10023c;
    }

    .fc .fc-button-primary {
      color: #fff;
    }
  </style>
</head>
<body>
  <%# Header %>
  <%- include("partials/header.ejs") %>
  <%# Main Page %>

  <div class="container" style="margin-top: 50px;">
    <h1 class="mb-4 text-center">John's Calendar</h1>
    <div id="calendar"></div>
  </div>

  <%# Footer %>
  <%- include("partials/footer.ejs") %>

  <%# Calender + Bootstrap plugin%>
  <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.8/index.global.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/daygrid@6.1.8/index.global.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/bootstrap5@6.1.8/index.global.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var calendarEl = document.getElementById('calendar');
      var calendar = new FullCalendar.Calendar(calendarEl, {
        themeSystem: 'bootstrap5',
        initialView: 'dayGridMonth',
        events: [
          { title: 'Project Kickoff', start: '2025-05-04' },
          { title: 'Team Offsite', start: '2025-05-12', end: '2025-05-14' }
        ]
      });
      calendar.render();
    });
  </script>
</body>
</html>